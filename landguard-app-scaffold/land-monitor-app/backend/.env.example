# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug  # debug | info | warn | error

# Database
DATABASE_URL=postgres://user:password@localhost:5432/land_monitor
DATABASE_SSL=false  # set to "true" for Render/Heroku managed Postgres

# Schema — all EarthGlobal tables live in a dedicated "earthglobal" schema,
# isolated from other apps sharing the same database.
# The search_path is set automatically via db.js, no action needed.

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Seed password (used by scripts/seed.js for test accounts)
SEED_PASSWORD=password123

# CORS — comma-separated list of allowed frontend origins (production only)
# CORS_ORIGINS=https://earthglobalgh.netlify.app,https://earthglobal.onrender.com

# Google Maps (frontend uses this too, kept here for reference)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Sentinel Hub
SENTINEL_HUB_CLIENT_ID=your_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_client_secret

# Google Earth Engine — for satellite imagery tiles + NDVI change detection.
# Option A (local dev): path to the service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/earthglobal-research2026-487611.json
# Option B (cloud deploy): paste the entire JSON key contents as an env var
# EE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"research2026-487611",...}
# The service account email is: earthglobal@research2026-487611.iam.gserviceaccount.com

# Storage (S3 / R2 compatible)
S3_BUCKET=land-monitor-media
S3_REGION=auto
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=https://your-r2-endpoint

# Payments
STRIPE_SECRET_KEY=sk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Notifications — Email (SendGrid)
# If not set, emails are logged to console instead of sent
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@earthglobal.com

# Notifications — SMS (Twilio)
# If not set, SMS messages are logged to console instead of sent
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

# Cron jobs
# Set to "true" to enable scheduled NDVI + building change detection in dev
ENABLE_NDVI_CRON=false
