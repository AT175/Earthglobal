# ═══════════════════════════════════════════════════════════════
# EarthGlobal — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL + PostGIS)
# All EarthGlobal tables live in a dedicated "earthglobal" schema,
# isolated from other apps sharing the same database.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/land_monitor
DATABASE_SSL=false

# ─────────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_min_32_chars

# ─────────────────────────────────────────────────────────────
# CORS (comma-separated list of allowed frontend origins)
# ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://earthglobalgh.netlify.app

# ─────────────────────────────────────────────────────────────
# STRIPE — Payments
# Publishable key is used in the frontend (VITE_STRIPE_PUBLISHABLE_KEY)
# Secret key is used in the backend
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Frontend (set in frontend .env or Netlify/Render env vars):
VITE_STRIPE_PUBLISHABLE_KEY=sb_publishable_L4s9Yu3IfhPcXm6xCW6T2Q_aJHSG-4Y

# ─────────────────────────────────────────────────────────────
# PAYSTACK (alternative payment provider for Africa)
# ─────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ─────────────────────────────────────────────────────────────
# GOOGLE MAPS API KEY (frontend map display — optional)
# If not set, the app uses free Leaflet/OpenStreetMap tiles instead
# ─────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key

# ─────────────────────────────────────────────────────────────
# GOOGLE EARTH ENGINE — satellite imagery + NDVI change detection
# Service account: earthglobal@research2026-487611.iam.gserviceaccount.com
#
# Option A (local dev): path to the service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/earthglobal-research2026-487611.json
#
# Option B (cloud deploy): paste the entire JSON key contents as env var
# EE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"research2026-487611",...}
# ─────────────────────────────────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=
# EE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────
# SENTINEL HUB (alternative satellite imagery source)
# ─────────────────────────────────────────────────────────────
SENTINEL_HUB_CLIENT_ID=your_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_client_secret

# ─────────────────────────────────────────────────────────────
# STORAGE (S3 / Cloudflare R2 compatible)
# Used for media uploads (visit photos/videos, deed docs)
# ─────────────────────────────────────────────────────────────
S3_BUCKET=land-monitor-media
S3_REGION=auto
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=https://your-r2-endpoint.r2.cloudflarestorage.com

# ─────────────────────────────────────────────────────────────
# NOTIFICATIONS
# ─────────────────────────────────────────────────────────────
# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@earthglobal.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ─────────────────────────────────────────────────────────────
# FRONTEND (Vite env vars — used at build time)
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# RENDER DEPLOYMENT
# These are set automatically by render.yaml or manually in the
# Render dashboard. See scripts/render-deploy.sh for automation.
# ─────────────────────────────────────────────────────────────
# RENDER_API_KEY=your_render_api_key  # for CLI deploys
# RENDER_SERVICE_ID=your_service_id
